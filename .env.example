# Run python3 scripts/init.py to generate local secrets.
PLATFORM_DOMAIN=platform.localhost
APPS_DOMAIN=apps.localhost
TLS_EMAIL=admin@example.com
POSTGRES_PASSWORD=
DATABASE_KEY=
PLATFORM_AUDIT_PASSWORD=
PLATFORM_AUDIT_READER_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_PROVISIONER_SECRET=
# Local reference hostname. For a public host, set identity.<your-domain> and its DNS record.
IDENTITY_DOMAIN=identity.localhost
# Create an individual Keycloak user first, then set its immutable `sub` value here for one-time bootstrap.
PLATFORM_BOOTSTRAP_SUBJECT=
GRAFANA_PASSWORD=
# Fixed private Docker subnet; choose a non-overlapping /24 before first startup.
PLATFORM_SUBNET=172.30.80.0/24
POSTGRES_IP=172.30.80.10
K3S_IMAGE=rancher/k3s:v1.36.4-k3s1
# Set 0.0.0.0 on the public host after configuring DNS and firewall.
EDGE_BIND_IP=127.0.0.1
# Registries the API may resolve image tags from (comma-separated, anonymous https only).
IMAGE_REGISTRIES=docker.io,ghcr.io,quay.io
# Seconds between background drift scans of applied projects.
DRIFT_SCAN_INTERVAL_SECONDS=300
# Revisions kept per project; the current revision and in-flight ones are never pruned.
REVISION_RETENTION=25
