# Run python3 scripts/init.py to generate local secrets.
PLATFORM_DOMAIN=platform.localhost
APPS_DOMAIN=apps.localhost
TLS_EMAIL=admin@example.com
POSTGRES_PASSWORD=
PLATFORM_TOKEN=
DATABASE_KEY=
GRAFANA_PASSWORD=
# Fixed private Docker subnet; choose a non-overlapping /24 before first startup.
