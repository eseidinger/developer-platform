# Run python3 scripts/init.py to generate local secrets.
PLATFORM_DOMAIN=platform.localhost
APPS_DOMAIN=apps.localhost
TLS_EMAIL=admin@example.com
POSTGRES_PASSWORD=
POSTGRES_MONITOR_PASSWORD=
DATABASE_KEY=
TELEMETRY_CATALOG_PASSWORD=
DATABASE_BASTION_TOKEN=
PLATFORM_AUDIT_PASSWORD=
PLATFORM_AUDIT_READER_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_PROVISIONER_SECRET=
# Local reference hostname. For a public host, set identity.<your-domain> and its DNS record.
IDENTITY_DOMAIN=identity.localhost
# Create an individual Keycloak user first, then set its immutable `sub` value here for one-time bootstrap.
PLATFORM_BOOTSTRAP_SUBJECT=
GRAFANA_PASSWORD=
# Fixed private Docker subnet; choose a non-overlapping /24 before first startup.
PLATFORM_SUBNET=172.30.80.0/24
TELEMETRY_GATEWAY_IP=172.30.80.13
ALLOY_IP=172.30.80.14
PLATFORM_TRACE_SAMPLE_RATE=1.0
AI_MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_DATA_REGION=eu
OPENAI_GLOBAL_PROCESSING_ACCEPTED=false
OPENAI_EU_PROJECT_VERIFIED=false
OPENAI_EU_PROCESSING_VERIFIED=false
OPENAI_MODIFIED_RETENTION_AMENDMENT_VERIFIED=false
POSTGRES_IP=172.30.80.10
# Stable private addresses consumed by the hosted-application boundary in k3d.
PLATFORM_API_IP=172.30.80.11
KEYCLOAK_IP=172.30.80.12
# Stable Compose addresses. Change these alongside the subnet before first startup.
PROXY_IP=172.30.80.20
BLACKBOX_EXPORTER_IP=172.30.80.21
PROMETHEUS_IP=172.30.80.22
GRAFANA_IP=172.30.80.23
TEMPO_IP=172.30.80.24
LOKI_IP=172.30.80.25
ALERTMANAGER_IP=172.30.80.26
POSTGRES_EXPORTER_IP=172.30.80.30
NODE_EXPORTER_IP=172.30.80.27
KEYCLOAK_DB_INIT_IP=172.30.80.28
KEYCLOAK_REALM_INIT_IP=172.30.80.29
K3S_IMAGE=rancher/k3s:v1.36.4-k3s1
# Set 0.0.0.0 on the public host after configuring DNS and firewall.
EDGE_BIND_IP=127.0.0.1
# Registries the API may resolve image tags from (comma-separated, anonymous https only).
IMAGE_REGISTRIES=docker.io,ghcr.io,quay.io
# Seconds between background drift scans of applied projects.
DRIFT_SCAN_INTERVAL_SECONDS=300
# Revisions kept per project; the current revision and in-flight ones are never pruned.
REVISION_RETENTION=25
# Conservative aggregate request admission is opt-in; measure reserves before enabling it permanently.
CAPACITY_ADMISSION_ENABLED=false
CAPACITY_RESERVE_CPU_MILLICORES=2000
CAPACITY_RESERVE_MEMORY_MIB=8192
