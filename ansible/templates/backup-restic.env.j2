# Root-only shell configuration, loaded by platform-restic.
# Values are shell-quoted; do not reuse this file as a systemd EnvironmentFile.
RESTIC_REPOSITORY={{ backup_restic_repository | quote }}
RESTIC_PASSWORD_FILE=/etc/developer-platform/backup/restic-password
AWS_ACCESS_KEY_ID={{ backup_s3_access_key | quote }}
AWS_SECRET_ACCESS_KEY={{ backup_s3_secret_key | quote }}
AWS_DEFAULT_REGION={{ backup_s3_region | quote }}
