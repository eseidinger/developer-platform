  "links": [
    {
      "title": "Named resources",
      "type": "link",
      "url": "/d/named-data-stores",
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "project",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(platform_store_quota_bytes{provider=\"opensearch\"}, project)",
        "refresh": 1,
