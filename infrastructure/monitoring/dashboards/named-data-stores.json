{
  "uid": "named-data-stores",
  "title": "Named data-store resources",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "developer-platform",
    "operator",
    "stores"
  ],
  "links": [
    {
      "title": "PostgreSQL",
      "type": "link",
      "url": "/d/postgresql",
      "keepTime": true
    },
    {
      "title": "RustFS S3",
      "type": "link",
      "url": "/d/rustfs-s3",
      "keepTime": true
    },
    {
      "title": "OpenSearch",
      "type": "link",
      "url": "/d/opensearch-performance",
      "keepTime": true
    },
    {
      "title": "Qdrant",
      "type": "link",
      "url": "/d/qdrant-performance",
      "keepTime": true
    },
    {
      "title": "Neo4j Community",
      "type": "link",
      "url": "/d/neo4j-community",
      "keepTime": true
    },
    {
      "title": "Apache AGE",
      "type": "link",
      "url": "/d/age-performance",
      "keepTime": true
    },
    {
      "title": "pgvector",
      "type": "link",
      "url": "/d/pgvector-performance",
      "keepTime": true
    },
    {
      "title": "DuckDB / Parquet",
      "type": "link",
      "url": "/d/duckdb-parquet",
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Logical usage / approved quota",
      "description": "Logical resource allocation. PostgreSQL byte quotas are advisory, not hard write limits. Missing usage is unknown. Missing data means collection or target discovery needs checking.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "platform_store_used_bytes / platform_store_quota_bytes",
          "legendFormat": "{{project}} {{resource_id}} {{provider}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Measured logical usage",
      "description": "Last successful sample; retained values may be stale. Not physical volume size or backup usage. Missing data means collection or target discovery needs checking.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "platform_store_used_bytes",
          "legendFormat": "{{project}} {{resource_id}} {{provider}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Usage measurement age",
      "description": "Zero timestamp means no successful reading. Sampling is bounded to eight resources per pass. Missing data means collection or target discovery needs checking.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - platform_store_usage_measured_timestamp_seconds",
          "legendFormat": "{{project}} {{resource_id}} {{provider}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Usage measurement errors",
      "description": "One means the latest attempt failed; last successful usage remains visible. Missing data means collection or target discovery needs checking.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "platform_store_usage_error",
          "legendFormat": "{{project}} {{resource_id}} {{provider}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Verified hard quota support",
      "description": "Zero means advisory enforcement. Monitoring and capacity admission do not enforce a hard provider byte limit. Missing data means collection or target discovery needs checking.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "platform_store_hard_quota",
          "legendFormat": "{{project}} {{resource_id}} {{provider}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Desired state pending",
      "description": "Provisioning, retirement, purge or configuration has not reached observed state. Missing data means collection or target discovery needs checking.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "platform_store_reconcile_pending",
          "legendFormat": "{{project}} {{resource_id}} {{provider}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Active credential generations",
      "description": "Includes bounded rotation overlap and early human renewal. No principal or credential IDs are labels. Missing data means collection or target discovery needs checking.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "platform_store_credentials_active",
          "legendFormat": "{{project}} {{resource_id}} {{provider}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Provider access cleanup pending",
      "description": "Expired or stale provider identities awaiting cleanup; relay denies them independently. Missing data means collection or target discovery needs checking.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "platform_store_credentials_cleanup_pending",
          "legendFormat": "{{project}} {{resource_id}} {{provider}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Recovery quarantine",
      "description": "One means restored access remains blocked until verified purge intents, source rebuild and credential cleanup complete. Old grants are never automatically reactivated. Missing data means collection or target discovery needs checking.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "expr": "platform_store_recovery_required",
          "legendFormat": "{{project}} {{resource_id}} {{provider}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Store controller heartbeat age",
      "description": "Committed worker pass and successful metrics publication. Missing/stale is unavailable, not idle. Missing data means collection or target discovery needs checking.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - platform_store_worker_last_success_timestamp_seconds",
          "legendFormat": "{{project}} {{resource_id}} {{provider}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
