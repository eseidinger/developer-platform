{
  "uid": "platform-health-delivery",
  "title": "Platform health and delivery",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "developer-platform",
    "operator"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Core scrape availability",
      "description": "Prometheus target availability (1 = scrape succeeded); this does not prove application health. Missing data means collection or target discovery needs checking.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"prometheus|host|kubernetes-state|blackbox-exporter|alloy\"}",
          "legendFormat": "{{job}} {{instance}} {{project}} {{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Public access boundary probes",
      "description": "A successful protected probe proves access boundary denial, not backend readiness. Missing data means collection or target discovery needs checking.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"applications\"}",
          "legendFormat": "{{job}} {{instance}} {{project}} {{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Unavailable component replicas",
      "description": "Kubernetes deployment status for project namespaces. Missing data means collection or target discovery needs checking.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_deployment_status_replicas_unavailable{namespace=~\"project-.*\"}",
          "legendFormat": "{{namespace}} / {{deployment}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Discovery age",
      "description": "Seconds since the platform published application target discovery. Missing data means collection or target discovery needs checking.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - platform_discovery_last_success_timestamp_seconds",
          "legendFormat": "{{job}} {{instance}} {{project}} {{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
