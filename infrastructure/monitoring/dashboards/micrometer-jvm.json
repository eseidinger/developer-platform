  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Collection state",
      "description": "One is a successful private scrape. This dashboard requires Micrometer JVM binders and a JVM runtime. Missing data means collection or target discovery needs checking.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"application-metrics\",project=\"$project\",application=\"$application\",component=\"$component\"}",
          "legendFormat": "Scrape"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "JVM uptime",
      "description": "Micrometer JVM/process metrics for the selected component. Unsupported binders produce no data. Missing data means collection or target discovery needs checking.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(process_uptime_seconds{job=\"application-metrics\",project=\"$project\",application=\"$application\",component=\"$component\"})",
          "legendFormat": "Uptime"
