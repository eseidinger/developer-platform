      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_locks_count{job=\"postgres\",datname=\"$database\"}",
          "legendFormat": "{{mode}}"
        }
