{
  "uid": "neo4j-community",
  "title": "Neo4j Community instance performance",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "developer-platform",
    "operator",
    "stores",
    "performance"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Provider selected",
      "description": "Operator selection; zero is disabled, missing means collector unavailable. Missing data means collection or target discovery needs checking.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "platform_native_selected{provider=\"neo4j\"}",
          "legendFormat": "{{project}} {{resource_id}} {{operation}} {{pool}} {{status}} {{scope}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Native collection health",
      "description": "One means this collector pass succeeded; resource samples have separate timestamps. Missing data means collection or target discovery needs checking.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "platform_native_collection_up{provider=\"containers\"}",
          "legendFormat": "{{project}} {{resource_id}} {{operation}} {{pool}} {{status}} {{scope}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Native collection age",
      "description": "Zero success timestamp means no successful sample. Old values are retained after failures. Missing data means collection or target discovery needs checking.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - platform_native_last_success_timestamp_seconds{provider=\"containers\"}",
          "legendFormat": "{{project}} {{resource_id}} {{operation}} {{pool}} {{status}} {{scope}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Container CPU cores used",
      "description": "Docker counter; shared services are not attributed to the selected project. Missing data means collection or target discovery needs checking.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(platform_native_container_cpu_seconds_total{provider=\"neo4j\",project=~\"$project\",resource_id=~\"$resource\"}[5m])",
          "legendFormat": "{{project}} {{resource_id}} {{operation}} {{pool}} {{status}} {{scope}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Container memory / limit",
      "description": "Docker memory excluding inactive file cache; instance/container scope. Missing data means collection or target discovery needs checking.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "platform_native_container_memory_bytes{provider=\"neo4j\",project=~\"$project\",resource_id=~\"$resource\"} / (platform_native_container_memory_limit_bytes{provider=\"neo4j\",project=~\"$project\",resource_id=~\"$resource\"} > 0)",
          "legendFormat": "{{project}} {{resource_id}} {{operation}} {{pool}} {{status}} {{scope}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Container restarts",
      "description": "Daemon restart count; replacement containers reset this gauge. Missing data means collection or target discovery needs checking.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "platform_native_container_restarts{provider=\"neo4j\",project=~\"$project\",resource_id=~\"$resource\"}",
          "legendFormat": "{{project}} {{resource_id}} {{operation}} {{pool}} {{status}} {{scope}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Container block I/O read",
      "description": "Docker block I/O counters; page-cache hits are not physical reads. Missing data means collection or target discovery needs checking.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(platform_native_container_read_bytes_total{provider=\"neo4j\",project=~\"$project\",resource_id=~\"$resource\"}[5m])",
          "legendFormat": "{{project}} {{resource_id}} {{operation}} {{pool}} {{status}} {{scope}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Container block I/O write",
      "description": "Docker block I/O counters; shared store activity is not per resource. Missing data means collection or target discovery needs checking.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(platform_native_container_write_bytes_total{provider=\"neo4j\",project=~\"$project\",resource_id=~\"$resource\"}[5m])",
          "legendFormat": "{{project}} {{resource_id}} {{operation}} {{pool}} {{status}} {{scope}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Instrumented workload throughput",
      "description": "Application-owned instrumentation; includes only opted-in operations, not every server query. Missing data means collection or target discovery needs checking.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation,outcome) (rate(platform_store_workload_duration_seconds_count{provider=\"neo4j\",project=~\"$project\",resource_id=~\"$resource\"}[5m]))",
          "legendFormat": "{{project}} {{resource_id}} {{operation}} {{pool}} {{status}} {{scope}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Instrumented workload p95 latency",
      "description": "Application histograms. No traffic means no latency estimate. Finite buckets end at 300 seconds. Missing data means collection or target discovery needs checking.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by (le,operation) (rate(platform_store_workload_duration_seconds_bucket{provider=\"neo4j\",project=~\"$project\",resource_id=~\"$resource\"}[5m])))",
          "legendFormat": "{{project}} {{resource_id}} {{operation}} {{pool}} {{status}} {{scope}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Instrumented workload errors",
      "description": "Application failure outcomes without query text or native diagnostics. Missing data means collection or target discovery needs checking.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation) (rate(platform_store_workload_duration_seconds_count{provider=\"neo4j\",project=~\"$project\",resource_id=~\"$resource\",outcome=\"error\"}[5m]))",
          "legendFormat": "{{project}} {{resource_id}} {{operation}} {{pool}} {{status}} {{scope}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Workload collection age",
      "description": "Requires the application metrics opt-in and the store-observability example. Missing means instrumentation is unavailable. Missing data means collection or target discovery needs checking.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time()-platform_store_workload_last_collection_timestamp_seconds{provider=\"neo4j\",project=~\"$project\",resource_id=~\"$resource\"}",
          "legendFormat": "{{project}} {{resource_id}} {{operation}} {{pool}} {{status}} {{scope}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Dedicated instance running",
      "description": "Retired instances can be intentionally stopped; check resource lifecycle and maintenance before alerting. Missing data means collection or target discovery needs checking.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "targets": [
        {
          "refId": "A",
          "expr": "platform_native_container_running{provider=\"neo4j\",project=~\"$project\",resource_id=~\"$resource\"}",
          "legendFormat": "{{project}} {{resource_id}} {{operation}} {{pool}} {{status}} {{scope}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ],
  "links": [
    {
      "title": "Named resources",
      "type": "link",
      "url": "/d/named-data-stores",
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "project",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(platform_store_quota_bytes{provider=\"neo4j\"}, project)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "resource",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(platform_store_quota_bytes{provider=\"neo4j\",project=~\"$project\"}, resource_id)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  }
}
