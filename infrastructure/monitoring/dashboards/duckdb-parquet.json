{
  "uid": "duckdb-parquet",
  "title": "DuckDB / Parquet analytics",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "developer-platform",
    "operator",
    "stores",
    "performance"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Instrumented workload throughput",
      "description": "Application-owned instrumentation; includes only opted-in operations, not every server query. Missing data means collection or target discovery needs checking.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation,outcome) (rate(platform_store_workload_duration_seconds_count{provider=\"duckdb\",project=~\"$project\",resource_id=~\"$resource\"}[5m]))",
          "legendFormat": "{{project}} {{resource_id}} {{operation}} {{pool}} {{status}} {{scope}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Instrumented workload p95 latency",
      "description": "Application histograms. No traffic means no latency estimate. Finite buckets end at 300 seconds. Missing data means collection or target discovery needs checking.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by (le,operation) (rate(platform_store_workload_duration_seconds_bucket{provider=\"duckdb\",project=~\"$project\",resource_id=~\"$resource\"}[5m])))",
          "legendFormat": "{{project}} {{resource_id}} {{operation}} {{pool}} {{status}} {{scope}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Instrumented workload errors",
      "description": "Application failure outcomes without query text or native diagnostics. Missing data means collection or target discovery needs checking.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation) (rate(platform_store_workload_duration_seconds_count{provider=\"duckdb\",project=~\"$project\",resource_id=~\"$resource\",outcome=\"error\"}[5m]))",
          "legendFormat": "{{project}} {{resource_id}} {{operation}} {{pool}} {{status}} {{scope}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Workload collection age",
      "description": "Requires the application metrics opt-in and the store-observability example. Missing means instrumentation is unavailable. Missing data means collection or target discovery needs checking.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time()-platform_store_workload_last_collection_timestamp_seconds{provider=\"duckdb\",project=~\"$project\",resource_id=~\"$resource\"}",
          "legendFormat": "{{project}} {{resource_id}} {{operation}} {{pool}} {{status}} {{scope}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Query CPU time",
      "description": "Selected numeric fields from the last profiled job; plans, paths, SQL and contents are excluded. These gauges are not cumulative counters. Missing data means collection or target discovery needs checking.",
      "datasource": {
        "type": "prometheus",
