  "links": [
    {
      "title": "Named resources",
      "type": "link",
      "url": "/d/named-data-stores",
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "project",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(platform_store_workload_last_collection_timestamp_seconds{provider=\"duckdb\"}, project)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "resource",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(platform_store_workload_last_collection_timestamp_seconds{provider=\"duckdb\",project=~\"$project\"}, resource_id)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  }
