{
  "uid": "application-metrics",
  "title": "Application metrics",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "developer-platform",
    "operator",
    "application-metrics"
  ],
  "templating": {
    "list": [
      {
        "name": "project",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"application-metrics\"}, project)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "application",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"application-metrics\",project=\"$project\"}, application)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "component",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"application-metrics\",project=\"$project\",application=\"$application\"}, component)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Collection state",
      "description": "One is a successful private scrape; zero is a failed scrape. Missing data means collection or target discovery needs checking.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"application-metrics\",project=\"$project\",application=\"$application\",component=\"$component\"}",
          "legendFormat": "{{job}} {{instance}} {{project}} {{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request rate",
      "description": "Five-minute HTTP request rate. Supports Micrometer and Prometheus FastAPI Instrumentator; prefers Micrometer if both are present. Missing data means collection or target discovery needs checking.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"application-metrics\",project=\"$project\",application=\"$application\",component=\"$component\"}[5m])) or sum(rate(http_requests_total{job=\"application-metrics\",project=\"$project\",application=\"$application\",component=\"$component\"}[5m]))",
          "legendFormat": "{{job}} {{instance}} {{project}} {{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Server error rate",
      "description": "Five-minute 5xx rate. Zero is shown only when a supported request counter is present. Missing data means collection or target discovery needs checking.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_server_requests_seconds_count{job=\"application-metrics\",project=\"$project\",application=\"$application\",component=\"$component\",status=~\"5..|5xx\"}[5m])) or sum(rate(http_requests_total{job=\"application-metrics\",project=\"$project\",application=\"$application\",component=\"$component\",status=~\"5..|5xx\"}[5m]))) or ((sum(rate(http_server_requests_seconds_count{job=\"application-metrics\",project=\"$project\",application=\"$application\",component=\"$component\"}[5m])) or sum(rate(http_requests_total{job=\"application-metrics\",project=\"$project\",application=\"$application\",component=\"$component\"}[5m]))) * 0)",
          "legendFormat": "{{job}} {{instance}} {{project}} {{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Mean request duration",
      "description": "Five-minute mean duration; no data until requests and a supported duration series exist. Missing data means collection or target discovery needs checking.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_server_requests_seconds_sum{job=\"application-metrics\",project=\"$project\",application=\"$application\",component=\"$component\"}[5m])) / (sum(rate(http_server_requests_seconds_count{job=\"application-metrics\",project=\"$project\",application=\"$application\",component=\"$component\"}[5m])) > 0)) or (sum(rate(http_request_duration_seconds_sum{job=\"application-metrics\",project=\"$project\",application=\"$application\",component=\"$component\"}[5m])) / (sum(rate(http_request_duration_seconds_count{job=\"application-metrics\",project=\"$project\",application=\"$application\",component=\"$component\"}[5m])) > 0))",
          "legendFormat": "{{job}} {{instance}} {{project}} {{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
