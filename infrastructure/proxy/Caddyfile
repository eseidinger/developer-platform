{
	email {$TLS_EMAIL}

	# Issue certificates only for hosts approved by the platform API.
	on_demand_tls {
		ask http://platform-api:8000/internal/tls
	}
}

# Keep the PostgreSQL console under its configured application prefix.
{$PLATFORM_DOMAIN} {
	redir /store-console/postgresql /store-console/postgresql/ 308
	handle_path /store-console/postgresql/* {
		reverse_proxy postgres-console:8080 {
			header_up X-Script-Name /store-console/postgresql
			header_up X-Scheme {scheme}
			header_up X-Forwarded-Prefix /store-console/postgresql
		}
	}
	handle {
		reverse_proxy platform-api:8000
	}
}

# Send identity traffic directly to the private identity service.
{$IDENTITY_DOMAIN} {
	reverse_proxy keycloak:8080
}

# Local application domains use HTTP; other domains redirect to HTTPS.
http://*.{$APPS_DOMAIN} {
	@local host *.apps.localhost
	handle @local {
		reverse_proxy k3d-workloads-serverlb:80
	}
	handle {
		redir https://{host}{uri} permanent
	}
}

# Both certificate policies share the same console and workload routing.
(application_routes) {
	@storeConsole {
		host *.{$APPS_DOMAIN}
		expression {host}.matches('^console-(200[0-9][0-9]|20[1-4][0-9][0-9]|2050[0-9]|2051[01])[.]')
	}
	handle @storeConsole {
		reverse_proxy platform-api:8000
	}
	@apps host *.{$APPS_DOMAIN}
	handle @apps {
		reverse_proxy k3d-workloads-serverlb:80
	}
	handle {
		respond 404
	}
}

# Public certificate authorities cannot issue certificates for localhost.
# Trust Caddy's local root CA in clients that use local HTTPS applications or
# native store consoles; keep their TLS verification enabled.
https://*.apps.localhost {
	tls internal
	import application_routes
}

# Public application domains obtain certificates only after API approval.
https:// {
	tls {
		on_demand
	}
	import application_routes
}
